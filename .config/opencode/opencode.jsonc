{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
      "@mohak34/opencode-notifier@latest",
      "@slkiser/opencode-quota"
  ],
  "mcp": {
      "context7": {
          "type": "remote",
          "url": "https://mcp.context7.com/mcp",
          "headers": {
              "CONTEXT7_API_KEY": "ctx7sk-06fa944e-e691-4ed7-babf-0982c7ef7f32"
          },
          "enabled": true
      }
  },
  "permission": {
    "external_directory": {
      "/nix/store/**": "allow"
    },
    "read": {
      "/nix/store/**": "allow"
    },
    "glob": {
      "/nix/store/**": "allow"
    },
    "grep": {
      "/nix/store/**": "allow"
    },
    "list": {
      "/nix/store/**": "allow"
    },
    "edit": {
      "/nix/store/**": "deny"
    }
  }
}
