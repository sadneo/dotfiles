{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
      "@mohak34/opencode-notifier@latest",
      "@slkiser/opencode-quota"
  ],
  "mcp": {
      "context7": {
          "type": "remote",
          "url": "https://mcp.context7.com/mcp",
          "headers": {
              "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
          },
          "enabled": true
      },
      "pixellab": {
          "type": "remote",
          "url": "https://api.pixellab.ai/mcp",
          "headers": {
              "Authorization": "{env:PIXELLAB_AUTHORIZATION}"
          },
          "enabled": true
      }
  },
  "permission": {
    "external_directory": {
      "/nix/store/**": "allow"
    },
    "read": {
      "/nix/store/**": "allow"
    },
    "glob": {
      "/nix/store/**": "allow"
    },
    "grep": {
      "/nix/store/**": "allow"
    },
    "list": {
      "/nix/store/**": "allow"
    },
    "edit": {
      "/nix/store/**": "deny"
    }
  },
  "provider": {
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {},
    // Detected openai authentication; opencode-quota added this global provider declaration.
    "openai": {},
    // Detected openrouter authentication; opencode-quota added this global provider declaration.
    "openrouter": {}
  }
}
